node_modules/
dist/
*.p8
.DS_Store
Thumbs.db
# Godot 4+ specific ignores
.godot/
/android/build/
/android/.gradle/
# Godot iOS export binaries (large, regenerated by export — not needed for SwiftGodotKit)
/MoltenVK.xcframework/
/Parsec.xcframework/
/Parsec.xcodeproj/
/Parsec/
/PrivacyInfo.xcprivacy

# iOS SwiftGodotKit app build artifacts
ios_app/*.xcodeproj/xcuserdata/
ios_app/*.xcodeproj/project.xcworkspace/xcshareddata/
ios_app/*.xcodeproj/project.xcworkspace/xcuserdata/
ios_app/build/
ios_app/*.xcodeproj/xcshareddata/swiftpm/Package.resolved
ios_app/LocalPackages/**/.build/

# Stray build artifacts
ios_app/Parsec.pck
/Debug/

# Game data spreadsheets: the .numbers files are the source of truth and ARE tracked
# (Asset_List = items, Artifact Data = artifacts, Enemy Data = enemies). Any .xlsx next to
# them is a throwaway Numbers export used to read the data programmatically — never an input,
# and stale the moment Numbers is saved again. Don't commit exports.
*.xlsx

# Capacitor iOS build tree (assets are copies of /assets)
/ios/

# Blender working files and scripts
/blender/
